{
    "name": "gratlinie/contao-gratreviews",
    "description": "GratReviews – Google-Bewertungen automatisch abrufen und im Stil von GratFrame anzeigen",
    "type": "contao-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Gratlinie",
            "email": "mail@gratlinie.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "symfony/http-client": "^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Gratlinie\\GratReviewsBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Gratlinie\\GratReviewsBundle\\ContaoManager\\Plugin"
    }
}
